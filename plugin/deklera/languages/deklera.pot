#: src/Preflight/Rules/TotalsConsistency.php:97
#, php-format
msgid "The VAT breakdown totals %1$s but WooCommerce recorded %2$s."
msgstr ""

#: src/Preflight/Rules/TotalsConsistency.php:101
msgid "The sum of the VAT breakdown must equal the VAT charged. A gap means a rate was applied that Deklera could not reconstruct from the order."
msgstr ""

#: src/Preflight/Rules/TotalsConsistency.php:102
msgid "Review the tax lines on the order and the rounding setting under WooCommerce > Settings > Tax."
msgstr ""

