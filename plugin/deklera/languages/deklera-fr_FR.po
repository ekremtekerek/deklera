#. Plugin Name of the plugin
#: deklera.php
#: src/Admin/PreflightPage.php:74
msgid "Deklera"
msgstr "Deklera"

#. Plugin URI of the plugin
#: deklera.php
msgid "https://github.com/ekremtekerek/deklera"
msgstr "https://github.com/ekremtekerek/deklera"

#. Description of the plugin
#: deklera.php
msgid "Turns WooCommerce orders into legally valid e-invoices for the seller's country and delivers them through the seller's own e-invoicing provider."
msgstr "Transforme les commandes WooCommerce en factures électroniques valables juridiquement pour le pays du vendeur et les transmet via le propre prestataire de facturation électronique du vendeur."

#. Author of the plugin
#: deklera.php
msgid "Hasan Ekrem Tekerek"
msgstr "Hasan Ekrem Tekerek"

#. translators: 1: required PHP version, 2: PHP version running on the server.
#: deklera.php:97
#, php-format
msgid "Deklera requires PHP %1$s or later. This server is running PHP %2$s."
msgstr "Deklera nécessite PHP %1$s ou une version ultérieure. Ce serveur exécute PHP %2$s."

#: deklera.php:108
msgid "Deklera dependencies are missing. Run \"composer install\" in the plugin directory."
msgstr "Les dépendances de Deklera sont absentes. Exécutez « composer install » dans le répertoire de l'extension."

