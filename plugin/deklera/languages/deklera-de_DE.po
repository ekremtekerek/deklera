#: src/Admin/PreflightPage.php:73
msgid "Deklera e-invoicing"
msgstr "Deklera E-Rechnung"

#: src/Admin/PreflightPage.php:88
msgid "You are not allowed to change these settings."
msgstr "Sie sind nicht berechtigt, diese Einstellungen zu ändern."

#: src/Admin/PreflightPage.php:169
msgid "You are not allowed to run this scan."
msgstr "Sie sind nicht berechtigt, diese Prüfung auszuführen."

#: src/Admin/PreflightPage.php:193
