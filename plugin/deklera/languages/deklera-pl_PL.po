#. Plugin Name of the plugin
#: deklera.php
#: src/Admin/PreflightPage.php:74
msgid "Deklera"
msgstr "Deklera"

#. Plugin URI of the plugin
#: deklera.php
msgid "https://github.com/ekremtekerek/deklera"
msgstr "https://github.com/ekremtekerek/deklera"

#. Description of the plugin
#: deklera.php
msgid "Turns WooCommerce orders into legally valid e-invoices for the seller's country and delivers them through the seller's own e-invoicing provider."
msgstr "Zamienia zamówienia WooCommerce w prawnie ważne e-faktury dla kraju sprzedawcy i przekazuje je przez własnego dostawcę e-fakturowania sprzedawcy."

#. Author of the plugin
#: deklera.php
msgid "Hasan Ekrem Tekerek"
msgstr "Hasan Ekrem Tekerek"

#. translators: 1: required PHP version, 2: PHP version running on the server.
#: deklera.php:97
#, php-format
msgid "Deklera requires PHP %1$s or later. This server is running PHP %2$s."
msgstr "Deklera wymaga PHP %1$s lub nowszego. Na tym serwerze działa PHP %2$s."

#: deklera.php:108
msgid "Deklera dependencies are missing. Run \"composer install\" in the plugin directory."
msgstr "Brakuje zależności Deklery. Uruchom „composer install” w katalogu wtyczki."

