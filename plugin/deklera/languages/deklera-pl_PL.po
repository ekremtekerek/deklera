#: src/Admin/PreflightPage.php:416
#, php-format
msgid "and %s more"
msgid_plural "and %s more"
msgstr[0] "i %s więcej"
msgstr[1] "i %s więcej"
msgstr[2] "i %s więcej"

#: src/Admin/PreflightPage.php:432
msgid "Settings"
msgstr "Ustawienia"

#: src/Admin/PreflightPage.php:440
msgid "Your VAT number"
msgstr "Twój numer VAT"

#: src/Admin/PreflightPage.php:442
msgid "WooCommerce has no field for this, so Deklera stores it. Include the country prefix."
msgstr "WooCommerce nie ma na to pola, więc Deklera przechowuje go osobno. Podaj przedrostek kraju."

#: src/Admin/PreflightPage.php:452
msgid "Contact name on the invoice"
msgstr "Osoba kontaktowa na fakturze"

#: src/Admin/PreflightPage.php:454
msgid "Leave empty to use the store name. Germany requires this field to be present."
msgstr "Zostaw puste, aby użyć nazwy sklepu. Niemcy wymagają, aby to pole było wypełnione."

#: src/Admin/PreflightPage.php:459
msgid "Contact telephone number"
msgstr "Numer telefonu kontaktowego"

#: src/Admin/PreflightPage.php:461
msgid "Required for German invoices (XRechnung). There is no sensible default, so it cannot be filled in for you."
msgstr "Wymagany dla faktur niemieckich (XRechnung). Nie istnieje sensowna wartość domyślna, więc pole nie może zostać wypełnione za Ciebie."

#: src/Admin/PreflightPage.php:467
msgid "Save"
msgstr "Zapisz"

#: src/Admin/PreflightPage.php:488
msgid "KSeF (Poland)"
msgstr "KSeF (Polska)"

#: src/Admin/PreflightPage.php:492
msgid "An FA(3) invoice does not legally exist until KSeF has accepted it and assigned a number. Deklera sends each invoice automatically and records the number."
msgstr "Faktura FA(3) nie istnieje w świetle prawa, dopóki KSeF jej nie przyjmie i nie nada jej numeru. Deklera wysyła każdą fakturę automatycznie i zapisuje numer."

#: src/Admin/PreflightPage.php:500
msgid "KSeF token"
msgstr "Token KSeF"

#: src/Admin/PreflightPage.php:502
msgid "Saved — leave blank to keep it"
msgstr "Zapisany — zostaw puste, aby go zachować"

#: src/Admin/PreflightPage.php:503
#: src/Admin/PreflightPage.php:581
msgid "Not set"
msgstr "Nie ustawiono"

#: src/Admin/PreflightPage.php:504
msgid "Generate the token in your KSeF account. It is stored on this site and never shown again."
msgstr "Wygeneruj token na swoim koncie KSeF. Jest przechowywany na tej stronie i nigdy nie zostanie ponownie wyświetlony."

#: src/Admin/PreflightPage.php:511
msgid "Environment"
msgstr "Środowisko"

#: src/Admin/PreflightPage.php:516
msgid "Test — invoices have no legal effect"
msgstr "Testowe — faktury nie wywołują skutków prawnych"

#: src/Admin/PreflightPage.php:517
msgid "Production — invoices are real"
msgstr "Produkcyjne — faktury są rzeczywiste"

#: src/Admin/PreflightPage.php:518
msgid "Start with Test. Invoices sent to Production are legally issued and cannot be withdrawn."
msgstr "Zacznij od środowiska testowego. Faktury wysłane na produkcję są wystawione w świetle prawa i nie można ich wycofać."

#: src/Admin/PreflightPage.php:547
msgid "Official validation (Pro)"
msgstr "Walidacja urzędowa (Pro)"

#: src/Admin/PreflightPage.php:552
msgid "Validation against the official EN 16931 rule set requires the Pro plan. It cannot run inside WordPress because the rule set needs XSLT 2.0, which PHP does not support."
msgstr "Walidacja wobec oficjalnego zestawu reguł EN 16931 wymaga planu Pro. Nie może działać wewnątrz WordPressa, ponieważ zestaw reguł wymaga XSLT 2.0, którego PHP nie obsługuje."

#: src/Admin/PreflightPage.php:564
msgid "One step left: paste your validation key below. It is in the email you received when you bought Pro. The service address is already filled in."
msgstr "Został jeden krok: wklej poniżej swój klucz walidacji. Znajdziesz go w wiadomości e-mail otrzymanej przy zakupie Pro. Adres usługi jest już uzupełniony."

#: src/Admin/PreflightPage.php:566
msgid "Read the setup guide"
msgstr "Przeczytaj przewodnik konfiguracji"

#: src/Admin/PreflightPage.php:572
msgid "Validation service address"
msgstr "Adres usługi walidacji"

#: src/Admin/PreflightPage.php:575
msgid "Already set to the service run by the plugin author. Change it only if you run your own copy of it."
msgstr "Ustawiony na usługę prowadzoną przez autora wtyczki. Zmień go tylko wtedy, gdy prowadzisz własną instancję."

#: src/Admin/PreflightPage.php:580
msgid "Validation key"
msgstr "Klucz walidacji"

#: src/Admin/PreflightPage.php:584
msgid "From your Pro purchase email. This is not the licence key that activated the plugin."
msgstr "Z wiadomości e-mail o zakupie Pro. To nie jest klucz licencyjny, którym aktywowano wtyczkę."

#: src/Admin/PreflightPage.php:585
msgid "Saved. Leave empty to keep it."
msgstr "Zapisany. Zostaw puste, aby go zachować."

