#: src/Admin/PreflightPage.php:73
msgid "Deklera e-invoicing"
msgstr "E-fakturowanie Deklera"

#: src/Admin/PreflightPage.php:88
msgid "You are not allowed to change these settings."
msgstr "Nie masz uprawnień do zmiany tych ustawień."

#: src/Admin/PreflightPage.php:169
msgid "You are not allowed to run this scan."
msgstr "Nie masz uprawnień do uruchomienia tego sprawdzenia."

#: src/Admin/PreflightPage.php:193
msgid "Deklera — e-invoicing pre-flight check"
msgstr "Deklera — kontrola wstępna e-faktur"

#: src/Admin/PreflightPage.php:198
