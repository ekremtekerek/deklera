# Servisin yayinlanacagi alan adi. A kaydi bu sunucuya bakmalidir;
# Caddy sertifikayi buna gore alir.
DOMAIN=validate.example.com

# Eklentinin Authorization: Bearer ... basliginda gonderecegi anahtar.
# Uretin:  openssl rand -hex 32
# Bu deger depoya GIRMEZ; yalnizca sunucudaki .env dosyasinda durur.
LICENSE_SECRET=

# EN 16931 kural seti surumu. Degistirirseniz imaji yeniden yapin.
RULES_VERSION=1.3.16

# Freemius urun kapsami gizli anahtari (pano -> urun -> Keys, sk_...).
# Lisansla yetkilendirme bunsuz calismaz; imzasiz cagriya Freemius 403 doner.
# Bu deger depoya GIRMEZ.
FREEMIUS_SECRET_KEY=
