<?xml version="1.0"?>
<ruleset name="Deklera">
	<description>Deklera kodlama standardi.</description>

	<file>plugin/deklera</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/vendor-prefixed/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>
	<arg name="cache" value=".phpcs-cache"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<!-- i18n: metin alani sabit ve dogru olmali. Bkz. docs/I18N.md -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="deklera"/>
			</property>
		</properties>
	</rule>

	<!-- Tum global isimler deklera_ ile onceklenir. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="deklera"/>
				<element value="Deklera"/>
				<element value="DEKLERA"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<!--
		PSR-4 + Composer autoload kullaniyoruz. WP cekirdeginin "class-locale.php"
		dosya adi kurali PSR-4 ile uyumsuzdur; sinif dosyalari sinif adini tasir.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<!--
		FA(3) modelinin ozellik adlari Polonya'nin resmi XSD'sinden uretilir
		(nrWierszaFa, p18A, pPMarzyN ...). Bizim degistirebilecegimiz adlar
		degil, o yuzden snake_case denetimi yalnizca o dosyada kapatiliyor.
	-->
	<rule ref="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase">
		<exclude-pattern>*/src/Invoice/Fa3Builder.php</exclude-pattern>
	</rule>

	<!-- Kancalar "deklera/" ile ad alanina alinir; bilincli tercih. -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>

	<!-- WPCS WooCommerce yetkilerini tanimaz. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>

	<!--
		base64, KSeF'te bir tercih degil PROTOKOL. Sifrelenmis jeton, sarmalanmis
		AES anahtari, IV ve faturanin kendisi API'ye base64 olarak gider; sertifika
		da oyle gelir. Sniff bunlari "kod gizleme" diye uyariyor.

		Uyari zararsiz gorunuyor ama degildi: phpcs uyarilarda da sifirdan farkli
		cikis kodu donuyor ve CI 4 Eylul'den beri BU YUZDEN kirmiziydi; kimse
		bakmadi, cunku "yalnizca uyari" sanildi. Ya susturulacak ya da yapi
		kalici olarak yalan soyleyecekti.

		Kapsam bilerek dar: yalnizca KSeF kodu ve onun testleri. Baska bir yerde
		base64 gorulurse yine uyarir.
	-->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode">
		<exclude-pattern>*/src/Ksef/*</exclude-pattern>
		<exclude-pattern>*/tests/Unit/ClientTest.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_decode">
		<exclude-pattern>*/src/Ksef/*</exclude-pattern>
		<exclude-pattern>*/tests/Unit/ClientTest.php</exclude-pattern>
	</rule>

	<!-- Gelistirme betikleri: WordPress disinda veya yalnizca WP-CLI altinda calisirlar. -->
	<!-- Bootstrap WordPress fonksiyonlarini bilerek sahteler; onek kurali gecerli degil. -->
	<exclude-pattern>*/tests/bootstrap.php</exclude-pattern>
	<exclude-pattern>*/tests/smoke.php</exclude-pattern>
	<exclude-pattern>*/tests/seed.php</exclude-pattern>

</ruleset>
